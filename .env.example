# ========================================================
# OUTZI.AI - Environment Variables
# ========================================================

# 1. Google Gemini API Key (Required for AI outing generation)
# Get a key from Google AI Studio: https://aistudio.google.com/
# This is loaded server-side only in server.ts and NEVER exposed to the browser.
GEMINI_API_KEY="your_gemini_api_key_here"

# 2. Server Port (Optional, defaults to 3000)
PORT=3000

# 3. Node Environment (development | production)
NODE_ENV="development"

# 4. App URL (Optional, auto-configured in production environments)
APP_URL="http://localhost:3000"

